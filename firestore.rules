rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // Helpers
    // ------------------------------------------------------------------

    function verified() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }

    function roomPath(roomId) {
      return /databases/$(database)/documents/rooms/$(roomId);
    }

    function talkPath(id) {
      return /databases/$(database)/documents/talkRequests/$(id);
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function usernamePath(name) {
      return /databases/$(database)/documents/usernames/$(name);
    }

    function isMember(roomId) {
      return verified()
        && exists(roomPath(roomId))
        && get(roomPath(roomId)).data.memberUids.hasAny([request.auth.uid]);
    }

    function isOwner(roomId) {
      return verified()
        && exists(roomPath(roomId))
        && get(roomPath(roomId)).data.ownerUid == request.auth.uid;
    }

    function validUsername(name) {
      return name is string
        && name.matches('[a-z0-9_]{3,20}')
        && !(name in ['admin', 'support', 'oneconnect', 'root', 'system']);
    }

    function validDisplayName(name) {
      return name is string
        && name.size() > 0
        && name.size() <= 80;
    }

    // X25519 public key, base64-encoded (32 bytes → 44 chars)
    function validPublicKey(key) {
      return key is string && key.size() == 44;
    }

    function validRoomCode(code) {
      return code is string && code.matches('[A-Z0-9]{6}');
    }

    function validMessageId(id) {
      return id is string && id.matches('[0-9a-f]{32}');
    }

    // A member entry inside a room's "members" map
    function validMember(m) {
      return m is map
        && m.size() <= 4
        && m.keys().hasAll(['displayName', 'publicKey'])
        && validDisplayName(m.displayName)
        && validPublicKey(m.publicKey)
        && (!('username' in m) || validUsername(m.username));
    }

    function roomIsOpen(room) {
      return room.closed == false
        && room.get('deleting', false) == false;
    }

    // Guest-room create must match an accepted talk request (same batch)
    function guestRoomMatchesRequest(roomId, room) {
      let other = room.memberUids[1];
      let talk = getAfter(talkPath(other + '_' + request.auth.uid)).data;
      return talk.status == 'accepted'
        && talk.roomCode == roomId
        && talk.toUid == request.auth.uid
        && talk.fromUid == other
        && room.members[other].publicKey == talk.publicKey
        && room.members[other].displayName == talk.fromName;
    }

    // ------------------------------------------------------------------
    // App config – public, read-only. Keep nothing secret here.
    // ------------------------------------------------------------------
    match /appConfig/{document} {
      allow read: if true;
      allow write: if false;
    }

    // ------------------------------------------------------------------
    // Usernames
    //
    // NOTE: list + limit ≤ 20 still permits full enumeration via cursors.
    // If you do not need prefix search, change the list rule to `if false`
    // and keep only exact get. Every username is then discoverable only by
    // knowing the exact string.
    // ------------------------------------------------------------------
    match /users/{uid} {
      allow get: if verified() && request.auth.uid == uid;

      allow create, update: if verified()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['username'])
        && validUsername(request.resource.data.username)
        && getAfter(usernamePath(request.resource.data.username)).data.uid == uid
        && (resource == null
            || !('username' in resource.data)
            || resource.data.username == request.resource.data.username
            || !existsAfter(usernamePath(resource.data.username)));

      allow delete: if false;
    }

    match /usernames/{username} {
      allow get: if verified();
      // Change to `if false` if you want to stop enumeration.
      allow list: if verified() && request.query.limit <= 20;

      allow create: if verified()
        && validUsername(username)
        && request.resource.data.keys().hasOnly(['uid', 'username', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == username
        && request.resource.data.createdAt == request.time
        && getAfter(userPath(request.auth.uid)).data.username == username;

      allow update: if false;

      allow delete: if verified()
        && resource.data.uid == request.auth.uid
        && getAfter(userPath(request.auth.uid)).data.username != username;
    }

    // ------------------------------------------------------------------
    // Talk requests (guest chats)
    //
    // Decline is permanent by design (sender cannot re-request after decline).
    // Only an accepted request can be turned back into pending after the
    // guest room has closed. A pending request cannot be cancelled by the
    // sender – product decision.
    // ------------------------------------------------------------------
    match /talkRequests/{requestId} {
      // Removed `resource == null` so existence cannot be probed.
      allow get: if verified()
        && (resource.data.fromUid == request.auth.uid
            || resource.data.toUid == request.auth.uid);

      allow list: if verified()
        && (resource.data.fromUid == request.auth.uid
            || resource.data.toUid == request.auth.uid);

      allow create: if verified()
        && request.resource.data.keys().hasOnly([
             'fromUid', 'toUid', 'fromUsername', 'toUsername',
             'fromName', 'publicKey', 'status', 'createdAt'
           ])
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && requestId == request.auth.uid + '_' + request.resource.data.toUid
        && request.resource.data.status == 'pending'
        && validUsername(request.resource.data.fromUsername)
        && validUsername(request.resource.data.toUsername)
        && get(userPath(request.auth.uid)).data.username
             == request.resource.data.fromUsername
        && get(usernamePath(request.resource.data.toUsername)).data.uid
             == request.resource.data.toUid
        && validDisplayName(request.resource.data.fromName)
        && validPublicKey(request.resource.data.publicKey)
        && request.resource.data.createdAt == request.time;

      // Recipient accepts or declines
      allow update: if verified()
        && resource.data.toUid == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'updatedAt', 'roomCode'])
        && request.resource.data.updatedAt == request.time
        && (
             (request.resource.data.status == 'declined'
                && !('roomCode' in request.resource.data))
             ||
             (request.resource.data.status == 'accepted'
                && validRoomCode(request.resource.data.roomCode)
                && getAfter(roomPath(request.resource.data.roomCode))
                     .data.memberUids
                     == [request.auth.uid, resource.data.fromUid])
           );

      // Sender may re-request only after a previous accepted chat closed
      allow update: if verified()
        && resource.data.fromUid == request.auth.uid
        && resource.data.status == 'accepted'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'updatedAt', 'roomCode', 'fromName', 'publicKey'])
        && request.resource.data.status == 'pending'
        && !('roomCode' in request.resource.data)
        && request.resource.data.updatedAt == request.time
        && validDisplayName(request.resource.data.fromName)
        && validPublicKey(request.resource.data.publicKey)
        && (!exists(roomPath(resource.data.roomCode))
            || get(roomPath(resource.data.roomCode)).data.closed == true);

      allow delete: if false;
    }

    // ------------------------------------------------------------------
    // Rooms
    //
    // LIMITATIONS (rules alone cannot fix these):
    // - Unlimited normal-room creation. Enforce “one main room per user”
    //   by storing a mainRoomCode on the user document and requiring a
    //   batch that sets it on create / clears it on close.
    // - Anyone can spam joinRequests against a guessed open 1-member room.
    //   App Check + client-side throttling are the practical mitigations.
    // ------------------------------------------------------------------
    match /rooms/{roomId} {

      allow get, list: if verified()
        && request.auth.uid in resource.data.memberUids;

      // Normal room (owner creates alone)
      allow create: if verified()
        && validRoomCode(roomId)
        && request.resource.data.keys().hasOnly([
             'ownerUid', 'memberUids', 'members',
             'verifiedUids', 'closed', 'createdAt'
           ])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.members.keys().hasOnly([request.auth.uid])
        && validMember(request.resource.data.members[request.auth.uid])
        && request.resource.data.verifiedUids == []
        && request.resource.data.closed == false
        && request.resource.data.createdAt == request.time;

      // Guest room – only via accepted talk request in the same batch
      allow create: if verified()
        && validRoomCode(roomId)
        && request.resource.data.keys().hasOnly([
             'kind', 'ownerUid', 'memberUids', 'members',
             'verifiedUids', 'closed', 'createdAt'
           ])
        && request.resource.data.kind == 'guest'
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids.size() == 2
        && request.resource.data.memberUids[0] == request.auth.uid
        && request.resource.data.memberUids[1] != request.auth.uid
        && request.resource.data.members.keys().hasOnly(
             request.resource.data.memberUids)
        && request.resource.data.members.keys().hasAll(
             request.resource.data.memberUids)
        && validMember(request.resource.data.members[request.auth.uid])
        && validMember(
             request.resource.data.members[request.resource.data.memberUids[1]])
        && request.resource.data.verifiedUids == []
        && request.resource.data.closed == false
        && request.resource.data.createdAt == request.time
        && guestRoomMatchesRequest(roomId, request.resource.data);

      // Owner approves join request → second member added
      allow update: if isOwner(roomId)
        && roomIsOpen(resource.data)
        && resource.data.memberUids.size() == 1
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['memberUids', 'members'])
        && request.resource.data.memberUids.size() == 2
        && request.resource.data.memberUids[0] == resource.data.ownerUid
        && request.resource.data.memberUids[1] != resource.data.ownerUid
        && !(request.resource.data.memberUids[1] in resource.data.members.keys())
        && request.resource.data.members.keys().hasOnly(
             request.resource.data.memberUids)
        && request.resource.data.members.keys().hasAll(
             request.resource.data.memberUids)
        && request.resource.data.members[resource.data.ownerUid]
             == resource.data.members[resource.data.ownerUid]
        && validMember(
             request.resource.data.members[request.resource.data.memberUids[1]])
        && request.resource.data.members[request.resource.data.memberUids[1]]
             .publicKey
             == getAfter(
                  /databases/$(database)/documents/rooms/$(roomId)
                    /joinRequests/$(request.resource.data.memberUids[1])
                ).data.publicKey
        && getAfter(
             /databases/$(database)/documents/rooms/$(roomId)
               /joinRequests/$(request.resource.data.memberUids[1])
           ).data.status == 'approved';

      // FIX: safety-code verification can no longer be forged.
      // Only the caller may append their own uid, and only once.
      allow update: if isMember(roomId)
        && roomIsOpen(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['verifiedUids'])
        && !(request.auth.uid in resource.data.verifiedUids)
        && request.resource.data.verifiedUids
             == resource.data.verifiedUids.concat([request.auth.uid]);

      // Non-owner leaves → room closes
      allow update: if isMember(roomId)
        && resource.data.get('deleting', false) == false
        && (resource.data.ownerUid != request.auth.uid
            || resource.data.get('kind', '') == 'guest')
        && request.resource.data.closed == true
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['ownerUid', 'memberUids', 'members', 'closed'])
        && request.resource.data.memberUids.size() <= 1
        && resource.data.memberUids.size()
             == request.resource.data.memberUids.size() + 1
        && resource.data.memberUids.hasAll(request.resource.data.memberUids)
        && !request.resource.data.memberUids.hasAny([request.auth.uid])
        && request.resource.data.members.keys().hasOnly(
             request.resource.data.memberUids)
        && request.resource.data.members.keys().hasAll(
             request.resource.data.memberUids)
        && (
             (request.resource.data.memberUids.size() == 0
                && request.resource.data.ownerUid == resource.data.ownerUid
                && request.resource.data.members.size() == 0)
             ||
             (request.resource.data.memberUids.size() == 1
                && request.resource.data.ownerUid
                     == request.resource.data.memberUids[0]
                && request.resource.data.members[request.resource.data.ownerUid]
                     == resource.data.members[request.resource.data.ownerUid])
           );

      // Owner marks room for deletion
      allow update: if isOwner(roomId)
        && resource.data.get('deleting', false) == false
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['closed', 'deleting'])
        && request.resource.data.closed == true
        && request.resource.data.deleting == true;

      allow delete: if isOwner(roomId)
        && resource.data.get('deleting', false) == true
        && resource.data.memberUids.hasAny([request.auth.uid]);

      // ---- Join requests ----
      match /joinRequests/{requesterUid} {
        allow create: if verified()
          && request.auth.uid == requesterUid
          && request.resource.data.keys().hasOnly([
               'requesterUid', 'displayName', 'username', 'publicKey',
               'status', 'createdAt'
             ])
          && request.resource.data.requesterUid == requesterUid
          && request.resource.data.status == 'pending'
          && validDisplayName(request.resource.data.displayName)
          && (!('username' in request.resource.data)
              || validUsername(request.resource.data.username))
          && validPublicKey(request.resource.data.publicKey)
          && request.resource.data.createdAt == request.time
          && exists(roomPath(roomId))
          && roomIsOpen(get(roomPath(roomId)).data)
          && get(roomPath(roomId)).data.memberUids.size() == 1
          && !get(roomPath(roomId)).data.memberUids.hasAny([requesterUid]);

        allow get, list: if verified()
          && (request.auth.uid == requesterUid || isOwner(roomId));

        allow update: if isOwner(roomId)
          && get(roomPath(roomId)).data.get('deleting', false) == false
          && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'updatedAt'])
          && request.resource.data.status in ['approved', 'rejected']
          && request.resource.data.updatedAt == request.time
          && (request.resource.data.status == 'rejected'
              || getAfter(roomPath(roomId)).data.memberUids
                   .hasAny([requesterUid]));

        allow update: if verified()
          && request.auth.uid == requesterUid
          && resource.data.status == 'rejected'
          && request.resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'updatedAt', 'username'])
          && (!('username' in request.resource.data)
              || validUsername(request.resource.data.username))
          && request.resource.data.updatedAt == request.time
          && roomIsOpen(get(roomPath(roomId)).data)
          && get(roomPath(roomId)).data.memberUids.size() == 1;

        allow delete: if isOwner(roomId)
          && get(roomPath(roomId)).data.get('deleting', false) == true;
      }

      // ---- Messages ----
      match /messages/{messageId} {
        allow get, list: if isMember(roomId);

        allow create: if isMember(roomId)
          && validMessageId(messageId)                 // new format check
          && roomIsOpen(get(roomPath(roomId)).data)
          && get(roomPath(roomId)).data.memberUids.size() == 2
          && get(roomPath(roomId)).data.verifiedUids
               .hasAll(get(roomPath(roomId)).data.memberUids)
          && request.resource.data.keys().hasOnly([
               'senderUid', 'ciphertext', 'sentAt', 'seenBy', 'replyToId'
             ])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.ciphertext is string
          && request.resource.data.ciphertext.size() <= 4096
          && request.resource.data.sentAt == request.time
          && request.resource.data.seenBy == [request.auth.uid]
          && (!('replyToId' in request.resource.data)
              || (validMessageId(request.resource.data.replyToId)
                  && exists(
                       /databases/$(database)/documents/rooms/$(roomId)
                         /messages/$(request.resource.data.replyToId)
                     )));

        // FIX: seenBy can only grow by exactly the caller’s uid, once.
        allow update: if isMember(roomId)
          && get(roomPath(roomId)).data.get('deleting', false) == false
          && resource.data.senderUid != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['seenBy'])
          && !(request.auth.uid in resource.data.seenBy)
          && request.resource.data.seenBy
               == resource.data.seenBy.concat([request.auth.uid]);

        // Reactions – only your own entry
        allow update: if isMember(roomId)
          && roomIsOpen(get(roomPath(roomId)).data)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['reactions'])
          && request.resource.data.reactions.diff(
               resource.data.get('reactions', {})
             ).affectedKeys().hasOnly([request.auth.uid])
          && (!(request.auth.uid in request.resource.data.reactions)
              || (request.resource.data.reactions[request.auth.uid] is string
                  && request.resource.data.reactions[request.auth.uid].size() >= 1
                  && request.resource.data.reactions[request.auth.uid].size() <= 16));

        allow delete: if isOwner(roomId)
          && get(roomPath(roomId)).data.get('deleting', false) == true;
      }
    }
  }
}